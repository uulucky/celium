<?xml version='1.0' encoding='utf-8'?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10" xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:uap4="http://schemas.microsoft.com/appx/manifest/uap/windows10/4" IgnorableNamespaces="uap uap4 rescap desktop">
  <Identity Name="Example.CeliumClient" Publisher="CN=ExamplePublisher" Version="1.1.44.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Celium</DisplayName>
    <PublisherDisplayName>Example Publisher</PublisherDisplayName>
    <Description>安全连接你的设备</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.33519.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources>
    <Resource Language="zh-CN" />
  </Resources>
  <Applications>
    <Application Id="Desktop" Executable="CeliumVpnApp.exe" EntryPoint="Celium.StoreVpn.App">
      <uap:VisualElements DisplayName="Celium" Description="安全连接你的设备" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="#0f1f33">
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap4:Extension Category="windows.loopbackAccessRules">
          <uap4:LoopbackAccessRules>
            <uap4:Rule Direction="in" PackageFamilyName="Example.CeliumClient_fwvj0qydysvq2" />
            <uap4:Rule Direction="out" PackageFamilyName="Example.CeliumClient_fwvj0qydysvq2" />
          </uap4:LoopbackAccessRules>
        </uap4:Extension>
        <Extension Category="windows.backgroundTasks" Executable="CeliumVpnApp.exe" EntryPoint="Celium.StoreVpn.BackgroundTask">
          <BackgroundTasks>
            <uap:Task Type="vpnClient" />
          </BackgroundTasks>
        </Extension>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="CeliumStore.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:FullTrustProcess>
            <desktop:ParameterGroup GroupId="Desktop" Parameters="--desktop" />
            <desktop:ParameterGroup GroupId="Broker" Parameters="--broker" />
          </desktop:FullTrustProcess>
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Extensions>
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>CeliumVpnPlugin.dll</Path>
        <ActivatableClass ActivatableClassId="Celium.StoreVpn.BackgroundTask" ThreadingModel="both" />
      </InProcessServer>
    </Extension>
  </Extensions>
  <Capabilities>
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="networkingVpnProvider" />
  </Capabilities>
</Package>
